# The website works without credentials in demo mode. All events are synthetic.
TRAY_MODE=demo
TRAY_TOKEN_SYMBOL=TRAY
TRAY_QUOTE_SYMBOL=QUOTE

# Required for live website + indexer. Use pooled Postgres for the website.
DATABASE_URL=
# Optional separate least-privilege read-only role for the public website.
DATABASE_READ_URL=
RPC_HTTP_URL=
RPC_WS_URL=
CHAIN_ID=
TOKEN_ADDRESS=
TOKEN_START_BLOCK=
# pons-v2 or uniswap-v3. Set actual, verified contracts for the chosen network.
MARKET_PROTOCOL=pons-v2
PONS_FACTORY_ADDRESS=
PONS_HOOK_ADDRESS=
V4_POOL_MANAGER_ADDRESS=
# For tokens originally launched using V1:
V3_POOL_ADDRESS=
CONFIRMATION_BLOCKS=2
RPC_BLOCK_BATCH=30
REORG_HISTORY_BLOCKS=128

# Paper-only operation. No private keys are used anywhere in this project.
PAPER_INITIAL_QUOTE=10000
PAPER_FEE_BPS=30
PAPER_SLIPPAGE_BPS=20
PAPER_MAX_EXPOSURE=0.25
# observer, momentum, or cortical. Cortical waits for real, fresh model results.
PAPER_POLICY=observer
INFERENCE_ENABLED=false
INFERENCE_REFRESH_SECONDS=15
INFERENCE_CONTEXT_SECONDS=100
INFERENCE_MAX_AGE_SECONDS=45

# GPU worker only. Do not put these in NEXT_PUBLIC variables or public files.
# Configure authorized use of the model before setting this to true.
TRIBE_ENABLED=false
TRIBE_RIGHTS_REFERENCE=
TRIBE_CODE_REVISION=af58661791a351a448a489042a28f6c37e1c14b7
TRIBE_WEIGHTS_REVISION=
TRIBE_MODEL_PATH=/models/tribev2
TRIBE_CACHE_PATH=/cache/tribev2
TRIBE_DEVICE=cuda
# Absolute directory on durable worker storage. Raw outputs stay here.
TRIBE_ARTIFACT_PATH=/data/tray
# This must be the exact revision of the feature encoders used for inference.
LLAMA_REVISION=
VJEPA_REVISION=
W2VBERT_REVISION=
HF_TOKEN=

# Local Compose Postgres only. Set a development password; never commit .env.
LOCAL_POSTGRES_PASSWORD=

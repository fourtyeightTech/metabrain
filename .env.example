# Live is the default. Missing configuration shows setup instructions, never fake events.
# Use METATRAY_MODE=demo explicitly only for the synthetic replay.
METATRAY_MODE=live
# rpc: read recent real swaps on Vercel. indexed: persistent ledger + optional GPU results.
METATRAY_FEED=rpc
METATRAY_TOKEN_SYMBOL=METATRAY
METATRAY_QUOTE_SYMBOL=QUOTE
# Optional public HTTPS contact page for terms/privacy requests. No personal details are supplied.
METATRAY_PUBLIC_CONTACT_URL=

# Minimum live RPC settings: RPC_HTTP_URL, CHAIN_ID, TOKEN_ADDRESS and factory/pool.
RPC_HTTP_URL=
CHAIN_ID=
TOKEN_ADDRESS=
MARKET_PROTOCOL=pons-v2
PONS_FACTORY_ADDRESS=
# For a compatible V3 pool, choose MARKET_PROTOCOL=uniswap-v3 instead.
V3_POOL_ADDRESS=
CONFIRMATION_BLOCKS=2
RPC_RECENT_BLOCKS=60
RPC_MAX_EVENTS=100
# Optional public HTTPS explorer base URL for transaction links.
BLOCK_EXPLORER_URL=

# Persistent indexer/GPU mode only. Set METATRAY_FEED=indexed on the website.
# Use pooled Postgres for the website and a direct session connection for workers.
DATABASE_URL=
# Optional separate least-privilege read-only role for the public website.
DATABASE_READ_URL=
RPC_WS_URL=
TOKEN_START_BLOCK=
# The RPC observer discovers these from the factory; the persistent indexer verifies both.
PONS_HOOK_ADDRESS=
V4_POOL_MANAGER_ADDRESS=
RPC_BLOCK_BATCH=30
REORG_HISTORY_BLOCKS=128

# Paper-only operation. No private keys are used anywhere in this project.
PAPER_INITIAL_QUOTE=10000
PAPER_FEE_BPS=30
PAPER_SLIPPAGE_BPS=20
PAPER_MAX_EXPOSURE=0.25
# observer, momentum, or cortical. Cortical waits for real, fresh model results.
PAPER_POLICY=observer
INFERENCE_ENABLED=false
INFERENCE_REFRESH_SECONDS=15
INFERENCE_CONTEXT_SECONDS=100
INFERENCE_MAX_AGE_SECONDS=45

# GPU worker only. Do not put these in NEXT_PUBLIC variables or public files.
# Configure authorized use of the model before setting this to true.
TRIBE_ENABLED=false
TRIBE_RIGHTS_REFERENCE=
TRIBE_CODE_REVISION=af58661791a351a448a489042a28f6c37e1c14b7
TRIBE_WEIGHTS_REVISION=
TRIBE_MODEL_PATH=/models/tribev2
TRIBE_CACHE_PATH=/cache/tribev2
TRIBE_DEVICE=cuda
# Absolute directory on durable worker storage. Raw outputs stay here.
TRIBE_ARTIFACT_PATH=/data/metatray
# This must be the exact revision of the feature encoders used for inference.
LLAMA_REVISION=
VJEPA_REVISION=
W2VBERT_REVISION=
HF_TOKEN=

# Local Compose Postgres only. Set a development password; never commit .env.
LOCAL_POSTGRES_PASSWORD=
